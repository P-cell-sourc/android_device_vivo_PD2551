# vivo vibrator service for TWRP AIDL haptics feedback
# (binary extracted from PD2551 stock vendor.img)
service vendor.vibrator-custom /vendor/bin/hw/vendor.vivo.hardware.vibrator.custom.service
    class hal
    user root
    group root input
    seclabel u:r:recovery:s0
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib:/sbin
