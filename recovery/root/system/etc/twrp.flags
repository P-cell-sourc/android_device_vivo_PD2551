# TWRP fstab (twrp.flags)
# For vivo iQOO PD2551 (V2551A, MT6899 / OriginOS 16, A/B dynamic partitions)
# Adapted from PD2183 scheme to PD2551 real partition map

# <mount>                    <type>          <path>                                          <mnt_flags and options>

/storage                     f2fs            /data/media/0                                   flags=display="Internal Storage";usermrf;fsflags="bind";backup=1;removable;

# A/B boot & verification images
/boot                        emmc            /dev/block/by-name/boot                         flags=display="Boot";slotselect;flashimg=1;backup=1;
/vendor_boot                 emmc            /dev/block/by-name/vendor_boot                  flags=display="Vendor_boot";slotselect;flashimg=1;backup=1;
/init_boot                   emmc            /dev/block/by-name/init_boot                    flags=display="Init_boot";slotselect;flashimg=1;backup=1;
/dtbo                        emmc            /dev/block/by-name/dtbo                         flags=display="DTBO";slotselect;flashimg=1;backup=1;
/vbmeta                      emmc            /dev/block/by-name/vbmeta                       flags=display="VBMeta";slotselect;flashimg=1;backup=1;
/vbmeta_vendor               emmc            /dev/block/by-name/vbmeta_vendor                flags=display="VBMeta_vendor";slotselect;flashimg=1;backup=1;
/vbmeta_system               emmc            /dev/block/by-name/vbmeta_system                flags=display="VBMeta_system";slotselect;flashimg=1;backup=1;
/vbmeta_oem                  emmc            /dev/block/by-name/vbmeta_oem                   flags=display="VBMeta_oem";slotselect;flashimg=1;backup=1;
/vbmeta_vgc                  emmc            /dev/block/by-name/vbmeta_vgc                   flags=display="VBMeta_vgc";slotselect;flashimg=1;backup=1;
/pvmfw                       emmc            /dev/block/by-name/pvmfw                        flags=display="pvmfw";slotselect;flashimg=1;backup=1;
/lk1                         emmc            /dev/block/by-name/lk1                          flags=display="lk";slotselect;
/bootloader2                 emmc            /dev/block/by-name/bootloader2                  flags=display="lk";slotselect;
/misc                        emmc            /dev/block/by-name/misc                         flags=display="misc";
/logo                        emmc            /dev/block/by-name/logo                         flags=display="Logo";

# MTK firmware partitions (A/B dual-slot where applicable)
/para                        emmc            /dev/block/by-name/para
/expdb                       emmc            /dev/block/by-name/expdb
/seccfg                      emmc            /dev/block/by-name/seccfg
/tee1                        emmc            /dev/block/by-name/tee1                         flags=display="tee";slotselect;
/tee2                        emmc            /dev/block/by-name/tee2                         flags=display="tee";slotselect;
/scp1                        emmc            /dev/block/by-name/scp1                         flags=display="scp";slotselect;
/scp2                        emmc            /dev/block/by-name/scp2                         flags=display="scp";slotselect;
/sspm1                       emmc            /dev/block/by-name/sspm1                        flags=display="sspm";slotselect;
/sspm2                       emmc            /dev/block/by-name/sspm2                        flags=display="sspm";slotselect;
/gz1                         emmc            /dev/block/by-name/gz1                          flags=display="gz";slotselect;
/gz2                         emmc            /dev/block/by-name/gz2                          flags=display="gz";slotselect;
/dpm1                        emmc            /dev/block/by-name/dpm1                         flags=display="dpm";slotselect;
/dpm2                        emmc            /dev/block/by-name/dpm2                         flags=display="dpm";slotselect;
/mcupm1                      emmc            /dev/block/by-name/mcupm1                       flags=display="mcupm";slotselect;
/mcupm2                      emmc            /dev/block/by-name/mcupm2                       flags=display="mcupm";slotselect;
/spmfw                       emmc            /dev/block/by-name/spmfw                        flags=display="spmfw";slotselect;
/audio_dsp                   emmc            /dev/block/by-name/audio_dsp                    flags=display="audio_dsp";slotselect;
/gpueb                       emmc            /dev/block/by-name/gpueb                        flags=display="gpueb";slotselect;
/vcp                         emmc            /dev/block/by-name/vcp                          flags=display="vcp";slotselect;
/ccu                         emmc            /dev/block/by-name/ccu                          flags=display="ccu";slotselect;
/apusys1                     emmc            /dev/block/by-name/apusys1                      flags=display="apusys";slotselect;
/apusys2                     emmc            /dev/block/by-name/apusys2                      flags=display="apusys";slotselect;
/mcf_ota                     emmc            /dev/block/by-name/mcf_ota                      flags=display="mcf_ota";slotselect;
/mvpu_algo1                  emmc            /dev/block/by-name/mvpu_algo1                   flags=display="mvpu_algo";slotselect;
/mvpu_algo2                  emmc            /dev/block/by-name/mvpu_algo2                   flags=display="mvpu_algo";slotselect;
/connsys_wifi                emmc            /dev/block/by-name/connsys_wifi                 flags=display="connsys_wifi";slotselect;
/connsys_bt                  emmc            /dev/block/by-name/connsys_bt                   flags=display="connsys_bt";slotselect;
/modem                       emmc            /dev/block/by-name/modem                        flags=display="modem";slotselect;
/md1dsp                      emmc            /dev/block/by-name/md1dsp
/md1arm7                     emmc            /dev/block/by-name/md1arm7
/md3img                      emmc            /dev/block/by-name/md3img
/pi_img                      emmc            /dev/block/by-name/pi_img
/boot_para                   emmc            /dev/block/by-name/boot_para
/odmdtbo                     emmc            /dev/block/by-name/odmdtbo                      flags=display="odmdtbo";slotselect;
/otp                         emmc            /dev/block/by-name/otp
/efuse                       emmc            /dev/block/by-name/efuse

# IMEI / NVRAM related (backup strongly recommended)
/nvram                       emmc            /dev/block/by-name/nvram                        flags=display="nvram";backup=1;
/nvcfg                       ext4            /dev/block/by-name/nvcfg                        flags=display="nvcfg";backup=1;
/nvdata                      ext4            /dev/block/by-name/nvdata                       flags=display="nvdata";backup=1;
/md_sec                      ext4            /dev/block/by-name/md_sec                       flags=display="md_sec";backup=1;
/protect_f                   ext4            /dev/block/by-name/protect1                     flags=display="Protect_f";backup=1;
/protect_s                   ext4            /dev/block/by-name/protect2                     flags=display="Protect_s";backup=1;
/proinfo                     emmc            /dev/block/by-name/proinfo                      flags=display="Proinfo";backup=1;
/persistent                  emmc            /dev/block/by-name/frp                          flags=display="Persistent";backup=1;

# Vivo partitions
/logdata                     ext4            /dev/block/by-name/logdata                      flags=display="logdata";
/factory                     ext4            /dev/block/by-name/factory                      flags=display="factory";

# Removable storage
/external_sd                 vfat            /dev/block/mmcblk1p1  /dev/block/mmcblk1        flags=display="MicroSD card";storage;wipeingui;removable;fsflags="utf8"
/usb-otg                     vfat            /dev/block/sda1       /dev/block/sda            flags=display="USB OTG";storage;wipeingui;removable;fsflags="utf8"

# Logical Partitions (EROFS)
/vendor                      erofs           /dev/block/mapper/vendor                        flags=display="Vendor_image";logical
/product                     erofs           /dev/block/mapper/product                       flags=display="Product_image";logical
/system                      erofs           /dev/block/mapper/system                        flags=display="System_image";logical
/system_ext                  erofs           /dev/block/mapper/system_ext                    flags=display="System_ext_image";logical
/odm                         erofs           /dev/block/mapper/odm                           flags=display="Odm_image";logical
/vendor_dlkm                 erofs           /dev/block/mapper/vendor_dlkm                   flags=display="Vendor_dlkm_image";logical
/odm_dlkm                    erofs           /dev/block/mapper/odm_dlkm                      flags=display="Odm_dlkm_image";logical
/system_dlkm                 erofs           /dev/block/mapper/system_dlkm                   flags=display="System_dlkm_image";logical
